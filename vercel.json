{
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gestoria.pt"
        }
      ],
      "destination": "https://celsopereira.pt/mapa",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.gestoria.pt"
        }
      ],
      "destination": "https://celsopereira.pt/mapa",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://celsopereira.pt/mapa",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/playbook",
      "destination": "https://backoffice-auditoria.vercel.app/playbook"
    },
    {
      "source": "/playbook/:path*",
      "destination": "https://backoffice-auditoria.vercel.app/playbook/:path*"
    },
    {
      "source": "/auditoria/:path*",
      "destination": "https://backoffice-auditoria.vercel.app/playbook/auditoria/:path*"
    }
  ]
}
